function submitModal(ev){ev.preventDefault();const d=Object.fromEntries(new FormData(ev.currentTarget)),{kind,id,item}=modalContext;const put=(arr,obj)=>{if(id){const i=arr.findIndex(x=>x.id===id);if(i>=0)arr[i]=obj}else arr.push(obj)};
if(kind==='course'){if(db.courses.some(c=>c.id!==id&&c.code&&c.code.toLowerCase()===d.code.toLowerCase()))return toast('Dieses Kürzel ist bereits vergeben.');put(db.courses,{...item,...d,id:id||uuid(),})}
