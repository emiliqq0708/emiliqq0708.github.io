function translateText(value){let out=value;for(const [from,to] of [...UI_EXTRA,...UI_COPY]){const escaped=from.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');out=out.replace(new RegExp(`(^|[^\\p{L}\\p{N}])${escaped}(?=$|[^\\p{L}\\p{N}])`,'giu'),`$1${to}`)}return out}
function translateDOM(root){const walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);let node;while(node=walker.nextNode()){if(node.parentElement?.closest('[data-user-content]'))continue;node.nodeValue=translateText(node.nodeValue)}root.querySelectorAll('[aria-label],[placeholder],[title]').forEach(el=>{for(const a of ['aria-label','placeholder','title'])if(el.hasAttribute(a))el.setAttribute(a,translateText(el.getAttribute(a)))})}
function confirmEnglish(message){return window.confirm(translateText(message))}
function promptEnglish(message,value=''){return window.prompt(translateText(message),translateText(value))}
const today=()=>iso(new Date());
function iso(d){return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`}
function addDays(value,n){const d=new Date(`${value}T12:00:00`);d.setDate(d.getDate()+n);return iso(d)}
function uuid(){return crypto.randomUUID?.()||`id-${Date.now()}-${Math.random().toString(36).slice(2)}`}
function starter(){const year=new Date().getFullYear();return{semester:{name:'Fall semester',start:`${year}-10-01`,end:`${year+1}-03-31`,weekGoal:12},courses:[],tasks:[],events:[],series:[],exceptions:[],blocks:[],notes:[],resources:[],sessions:[]}}
function migrate(){try{const raw=JSON.parse(localStorage.getItem(KEY));if(raw&&raw.semester){for(const e of raw.events||[])e.type=({'Prüfung':'Exam','Abgabe':'Assignment','Termin':'Personal event','Vorlesung':'Lecture'}[e.type]||e.type);for(const s of raw.series||[])s.type=({'Vorlesung':'Lecture','Übung':'Tutorial','Sprechstunde':'Office hours','Sonstiges':'Other'}[s.type]||s.type);return raw}const old=JSON.parse(localStorage.getItem('studyhub-data-v1'));if(old){const d=starter();d.courses=old.courses.map((c,i)=>({...c,color:COLORS[i%COLORS.length]}));d.tasks=old.tasks;d.events=old.events.map(e=>({...e,type:({'Prüfung':'Exam','Abgabe':'Assignment','Termin':'Personal event'}[e.type]||e.type),plan:e.plan||[]}));d.series=old.classes.map(c=>({id:c.id,title:d.courses.find(x=>x.id===c.courseId)?.name||'Class',courseId:c.courseId,day:['Montag','Dienstag','Mittwoch','Donnerstag','Freitag','Samstag','Sonntag'].indexOf(c.day),start:c.start,end:c.end,room:c.room||'',lecturer:'',type:'Lecture',from:d.semester.start,to:d.semester.end}));localStorage.setItem(KEY,JSON.stringify(d));return d;}}catch(e){console.warn('Study Hub data could not be read',e)}return starter()}
