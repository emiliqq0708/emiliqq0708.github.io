function focusPage(){const m=Math.floor(timer.remaining/60),s=timer.remaining%60;const mins=db.sessions.filter(x=>x.date>=addDays(today(),-6)).reduce((n,x)=>n+x.minutes,0);return `${header('GUTER FOKUS','Fokuszeit','Arbeite in ruhigen Intervallen und halte deine Lernzeit fest.','')}<div class="focus-layout"><section class="timer-card"><span class="kicker">${timer.kind==='study'?'LERNZEIT':'PAUSE'}</span><div class="timer-display" id="timer-display">${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}</div><div class="timer-actions">${btn(timer.running?'Pause':timer.remaining<timerSettings[timer.kind]*60?'Resume':'Start',timer.running?'timer-pause':'timer-start')}${btn('Zurücksetzen','timer-reset','','soft')}</div><div class="timer-config"><label>Lernen <input id="study-min" type="number" min="1" max="180" value="${timerSettings.study}"> min</label><label>Pause <input id="break-min" type="number" min="1" max="60" value="${timerSettings.break}"> min</label><button class="link" data-action="timer-settings">Übernehmen</button></div></section><section class="surface"><div class="surface-head"><div><h2>Diese Woche</h2><p>Erfasste Fokuszeit</p></div></div><div class="big-stat">${(mins/60).toFixed(1)} <small>Stunden</small></div><div class="progress-track"><i style="width:${Math.min(100,mins/(db.semester.weekGoal*60)*100)}%"></i></div><p class="muted">Wochenziel ${db.semester.weekGoal} Stunden</p>${db.sessions.slice(-5).reverse().map(s=>`<div class="mini-row">${pretty(s.date,{weekday:'short',day:'numeric',month:'short'})}<small>${s.minutes} Minuten Fokuszeit</small></div>`).join('')}</section></div>`}
