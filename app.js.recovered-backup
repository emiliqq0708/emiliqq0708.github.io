function nextClassDate(from,day){let d=from>today()?from:today();while(((new Date(`${d}T12:00:00`).getDay()+6)%7)!==Number(day))d=addDays(d,1);return d}
function calendarItems(start,end){const tasks=db.tasks.filter(t=>t.due>=start&&t.due<=end).map(t=>({id:`task:${t.id}`,title:t.title,date:t.due,type:'Task',courseId:t.courseId,subjectName:t.subjectName,time:'',endTime:'',done:t.done,occurrence:false}));return [...occurrences(start,end),...tasks].sort((a,b)=>(a.date+(a.time||'')).localeCompare(b.date+(b.time||'')))}
function subjectName(data){const picked=data.courseId&&course(data.courseId);if(picked){data.subjectName='';return}data.courseId='';data.subjectName=(data.subjectName||'').trim()}
function dataList(arr,id){return arr.find(x=>x.id===id)}

function occurrences(start,end){let from=new Date(`${start}T12:00:00`),to=new Date(`${end}T12:00:00`),semStart=new Date(`${db.semester.start}T12:00:00`),semEnd=new Date(`${db.semester.end}T12:00:00`);if(from<semStart)from=semStart;if(to>semEnd)to=semEnd;const out=[];for(let d=new Date(from);d<=to;d.setDate(d.getDate()+1)){const key=iso(d),weekday=(d.getDay()+6)%7;if(db.blocks.some(b=>key>=b.from&&key<=b.to))continue;for(const s of db.series.filter(x=>Number(x.day)===weekday&&key>=x.from&&key<=x.to)){const ex=db.exceptions.find(x=>x.seriesId===s.id&&x.date===key);if(ex?.cancelled)continue;out.push({...s,...(ex||{}),date:key,originalDate:key,occurrence:true,id:`${s.id}@${key}`,overlap:false})}for(const e of db.events.filter(x=>x.date===key))out.push({...e,originalDate:key,occurrence:false,overlap:false})}const startOf=e=>e.time||e.start||'',endOf=e=>e.endTime||e.end||'';out.sort((a,b)=>(a.date+startOf(a)).localeCompare(b.date+startOf(b)));const collisions=new Set();for(let i=0;i<out.length;i++)for(let j=i+1;j<out.length&&out[j].date===out[i].date;j++)if(startOf(out[i])&&startOf(out[j])&&startOf(out[i])<endOf(out[j])&&startOf(out[j])<endOf(out[i])){collisions.add(i);collisions.add(j)}return out.map((e,i)=>({...e,overlap:collisions.has(i)}))}
function pageHeader(label,title,subtitle,action=''){return header(label,title,subtitle,action)}
function dashboard(){const all=occurrences(today(),addDays(today(),7)),todayItems=all.filter(x=>x.date===today()),deadlines=openTasks().filter(t=>t.due).sort((a,b)=>a.due.localeCompare(b.due)).slice(0,5),exams=db.events.filter(e=>e.type==='Exam'&&e.date>=today()).sort((a,b)=>a.date.localeCompare(b.date)),exam=exams[0],late=openTasks().filter(t=>t.due&&t.due<today()),done=db.tasks.filter(t=>t.done).length,mins=db.sessions.filter(x=>x.date>=addDays(today(),-6)).reduce((n,x)=>n+x.minutes,0),greet=new Date().getHours()<12?'Good morning':new Date().getHours()<18?'Good afternoon':'Good evening';return `${pageHeader('YOUR CAMPUS',`${greet}.`,'Your day, classes, and deadlines in one calm view.')}<section class="hero"><div><span class="hero-label">${esc(db.semester.name)}</span><h2>Make room<br>for your next win.</h2><p>${pretty(today(),{weekday:'long',day:'numeric',month:'long'})} <span>·</span> ${todayItems.length} events today</p></div><div class="hero-stat"><span>SEMESTER PROGRESS</span><strong>${semesterProgress()}%</strong><div class="progress-track"><i style="width:${semesterProgress()}%"></i></div></div></section><div class="stats"><article class="stat"><span>Open tasks</span><strong>${openTasks().length}</strong><small>${late.length} overdue</small></article><article class="stat"><span>Due today</span><strong>${openTasks().filter(t=>t.due===today()).length}</strong><small>Across your subjects</small></article><article class="stat"><span>Study time this week</span><strong>${(mins/60).toFixed(1)}<small> hrs</small></strong><small>Recorded focus sessions</small></article><article class="stat"><span>Completed tasks</span><strong>${done}</strong><small>of ${db.tasks.length} total</small></article></div><div class="quick-actions">${btn('＋ Add task','new','task','soft')}${btn('＋ Class','new','series','soft')}${btn('＋ Exam','new','exam','soft')}${exam?`<div class="exam-chip"><span>NEXT EXAM</span><strong>${esc(exam.title)}</strong><b>${Math.max(0,Math.ceil((new Date(exam.date+'T12:00:00')-new Date(today()+'T12:00:00'))/86400000))} days</b></div>`:''}</div><div class="columns"><section class="surface"><div class="surface-head"><div><h2>Today’s schedule</h2><p>Classes and events for today</p></div><button class="link" data-page="semester">Open timetable →</button></div>${todayItems.map(eventCard).join('')||'<div class="empty">Nothing scheduled today. <button class="link" data-action="new" data-kind="series">Add a class</button></div>'}</section><section class="surface"><div class="surface-head"><div><h2>Upcoming deadlines</h2><p>Tasks and exams coming up</p></div><button class="link" data-page="tasks">View tasks →</button></div>${deadlines.map(taskCard).join('')||'<div class="empty">No open deadlines. <button class="link" data-action="new" data-kind="task">Add a task</button></div>'}${exams.slice(0,2).map(eventCard).join('')}</section></div>`}
function eventCard(e){const c=course(e.courseId);return `<div class="event-card ${e.overlap?'conflict':''}" data-action="occurrence" data-id="${e.id}" role="button" tabindex="0"><span class="datebox"><b>${pretty(e.date,{day:'numeric'})}</b><small>${pretty(e.date,{month:'short'})}</small></span><div class="event-info"><strong data-user-content>${esc(e.title||c?.name||e.subjectName||'Class')}</strong><small data-user-content>${esc(e.time||e.start||(e.type==='Task'?'Due date':''))} · ${esc(e.location||e.room||e.type||'Class')}${e.overlap?' · Time conflict':''}</small></div><i class="course-color" style="--c:${c?.color||'#8975d6'}"></i></div>`}
