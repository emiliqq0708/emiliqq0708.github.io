document.querySelector('#modal-title').textContent=title;document.querySelector('#modal-fields').innerHTML=html;document.querySelector('.modal-delete')?.remove();if(id&&['course','task','event','series','block','note'].includes(kind)){const b=document.createElement('button');b.type='button';b.className='btn danger-btn modal-delete';b.textContent='Löschen';b.dataset.action='delete';b.dataset.kind=kind;b.dataset.id=id;document.querySelector('.dialog-actions').prepend(b)}translateDOM(document.querySelector('#dialog'));document.querySelector('#dialog').showModal();}
