function occurrences(start,end){let from=new Date(`${start}T12:00:00`),to=new Date(`${end}T12:00:00`);if(from<new Date(`${db.semester.start}T12:00:00`))from=new Date(`${db.semester.start}T12:00:00`);if(to>new Date(`${db.semester.end}T12:00:00`))to=new Date(`${db.semester.end}T12:00:00`);const out=[];for(let d=new Date(from);d<=to;d.setDate(d.getDate()+1)){const key=iso(d),day=(d.getDay()+6)%7;if(db.blocks.some(b=>key>=b.from&&key<=b.to))continue;for(const s of db.series.filter(s=>s.day===day&&key>=s.from&&key<=s.to)){const ex=db.exceptions.find(e=>e.seriesId===s.id&&e.date===key);if(ex?.cancelled)continue;const shift=ex?.start?ex:null;out.push({...s,...shift,date:key,originalDate:key,occurrence:true,id:`${s.id}@${key}`,overlap:false})}for(const e of db.events.filter(e=>e.date===key))out.push({...e,originalDate:key,occurrence:false});}out.sort((a,b)=>(a.date+a.time).localeCompare(b.date+b.time));const collision=new Set();for(let i=0;i<out.length;i++)for(let j=i+1;j<out.length;j++){const a=out[i],b=out[j];if(a.date!==b.date)break;if(a.time&&b.time&&(a.time<(b.endTime||a.end||'23:59')&&b.time<(a.endTime||a.end||'23:59'))){collision.add(i);collision.add(j)}}return out.map((e,i)=>({...e,overlap:collision.has(i)}))}
function dashboard(){const all=occurrences(today(),addDays(today(),7)),todayItems=all.filter(x=>x.date===today()),deadlines=openTasks().filter(t=>t.due).sort((a,b)=>a.due.localeCompare(b.due)).slice(0,5),upcomingExam=db.events.filter(e=>e.type==='Exam'&&e.date>=today()).sort((a,b)=>a.date.localeCompare(b.date))[0],late=openTasks().filter(t=>t.due&&t.due<today()),done=db.tasks.filter(t=>t.done).length,progress=db.tasks.length?Math.round(done/db.tasks.length*100):0,minutes=db.sessions.filter(x=>x.date>=addDays(today(),-6)).reduce((n,x)=>n+x.minutes,0),hour=new Date().getHours(),greeting=hour<12?'Good morning':hour<18?'Good afternoon':'Good evening';return `${header('YOUR CAMPUS',`${greeting}.`,'A little more space for what matters today.','')}<section class="hero"><div><span class="hero-label">${esc(db.semester.name)}</span><h2>Make room<br>for your next win.</h2><p>${pretty(today(),{weekday:'long',day:'numeric',month:'long'})} <span>·</span> ${todayItems.length} classes today</p></div><div class="hero-stat"><span>SEMESTER PROGRESS</span><strong>${semesterProgress()}%</strong><div class="progress-track"><i style="width:${semesterProgress()}%"></i></div></div></section><div class="stats"><article class="stat"><span>Open tasks</span><strong>${openTasks().length}</strong><small>${late.length} overdue</small></article><article class="stat"><span>Due today</span><strong>${openTasks().filter(t=>t.due===today()).length}</strong><small>One step at a time</small></article><article class="stat"><span>Study time this week</span><strong>${(minutes/60).toFixed(1)}<small> hrs</small></strong><small>Weekly goal: ${db.semester.weekGoal} hours</small></article><article class="stat"><span>Tasks completed</span><strong>${progress}<small>%</small></strong><small>${done} of ${db.tasks.length} tasks</small></article></div><div class="quick-actions">${btn('＋ Add task','new','task','soft')}${btn('＋ Add class','new','series','soft')}${btn('＋ Add note','new','note','soft')}${upcomingExam?`<div class="exam-chip"><span>NEXT EXAM</span><strong>${esc(upcomingExam.title)}</strong><b>${Math.max(0,Math.ceil((new Date(upcomingExam.date+'T12:00:00')-new Date(today()+'T12:00:00'))/86400000))} days</b></div>`:''}</div><div class="columns"><section class="surface"><div class="surface-head"><div><h2>Today’s schedule</h2><p>Your classes and events for today</p></div><button class="link" data-page="calendar">Open calendar →</button></div>${todayItems.map(eventCard).join('')||`<div class="empty">Nothing on your schedule today. <button class="link" data-action="new" data-kind="series">Add a class</button></div>`}</section><section class="surface"><div class="surface-head"><div><h2>Upcoming deadlines</h2><p>Overdue and coming up next</p></div><button class="link" data-page="tasks">View all tasks →</button></div>${deadlines.map(taskCard).join('')||`<div class="empty">You’re all caught up. <button class="link" data-action="new" data-kind="task">Add a task</button></div>`}</section></div>`}function semesterProgress(){const s=new Date(db.semester.start+'T12:00:00'),e=new Date(db.semester.end+'T12:00:00'),n=new Date(today()+'T12:00:00');return Math.max(0,Math.min(100,Math.round((n-s)/(e-s)*100)))}
