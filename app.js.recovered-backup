save();document.querySelector('#dialog').close();render();toast('Gespeichert');}
function deleteItem(kind,id){const labels={course:'course',task:'task',event:'event',series:'recurring class series',block:'break period',note:'note'};if(kind==='course'&&(db.tasks.some(x=>x.courseId===id)||db.events.some(x=>x.courseId===id)||db.series.some(x=>x.courseId===id)||db.notes.some(x=>x.courseId===id)))return toast('This course still has linked items. Remove or reassign them first.');if(!confirmEnglish(`Delete this ${labels[kind]||'item'}?`))return;const arr={course:db.courses,task:db.tasks,event:db.events,series:db.series,block:db.blocks,note:db.notes}[kind];if(!arr)return;const index=arr.findIndex(x=>x.id===id);if(index<0)return;arr.splice(index,1);if(kind==='series')db.exceptions=db.exceptions.filter(x=>x.seriesId!==id);save();render();toast('Item deleted')}
function occurrenceAction(id,action){const [sid,date]=id.split('@'),existing=db.exceptions.find(e=>e.seriesId===sid&&e.date===date),s=db.series.find(x=>x.id===sid);if(!s)return;const choice=promptEnglish(`Edit the class on ${pretty(date)}: enter “cancel”, “move”, or “details”.`,existing?'move':'');if(!choice)return;const mode=choice.toLowerCase();if(mode.startsWith('c')){if(existing)existing.cancelled=true;else db.exceptions.push({seriesId:sid,date,cancelled:true});save();render();toast('Single occurrence cancelled');return}if(mode.startsWith('m')||mode.startsWith('d')||mode.startsWith('e')){const start=promptEnglish('New start time (HH:MM)',existing?.start||s.start);if(!start)return;if(!/^([01]\d|2[0-3]):[0-5]\d$/.test(start))return toast('Enter a time in HH:MM format.');const end=promptEnglish('New end time (HH:MM)',existing?.end||s.end);if(!end)return;if(!/^([01]\d|2[0-3]):[0-5]\d$/.test(end)||end<=start)return toast('End time must be after the start time.');const data={seriesId:sid,date,start,end,cancelled:false};if(mode.startsWith('d')||mode.startsWith('e')){data.title=promptEnglish('Title for this occurrence',existing?.title||s.title)||s.title;data.room=promptEnglish('Room for this occurrence',existing?.room||s.room)||''}if(existing)Object.assign(existing,data);else db.exceptions.push(data);save();render();toast('Single occurrence updated')}}
function exportBackup(){const blob=new Blob([JSON.stringify(db,null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`study-hub-backup-${today()}.json`;a.click();URL.revokeObjectURL(a.href);toast('Backup exportiert')}
function importBackup(file){const r=new FileReader();r.onload=()=>{try{const x=JSON.parse(r.result);if(!x.semester||!Array.isArray(x.courses)||!Array.isArray(x.tasks)||!Array.isArray(x.series)||!Array.isArray(x.events))throw Error();if(!confirmEnglish('Import ersetzt alle aktuell gespeicherten Daten. Fortfahren?'))return;db={...starter(),...x};save();render();toast('Backup importiert')}catch{toast('Datei ist kein gültiges Study Hub Backup.')}};r.readAsText(file)}
function timerStart(){if(timer.running)return;timer.running=true;timer.started=Date.now()-(timerSettings[timer.kind]*60-timer.remaining)*1000;timer.interval=setInterval(()=>{timer.remaining=Math.max(0,timerSettings[timer.kind]*60-Math.floor((Date.now()-timer.started)/1000));const el=document.querySelector('#timer-display');if(el)el.textContent=`${String(Math.floor(timer.remaining/60)).padStart(2,'0')}:${String(timer.remaining%60).padStart(2,'0')}`;if(!timer.remaining){clearInterval(timer.interval);timer.running=false;if(timer.kind==='study'){db.sessions.push({date:today(),minutes:timerSettings.study});save();timer.kind='break';toast('Fokusblock geschafft. Zeit für eine Pause!')}else{timer.kind='study';toast('Pause vorbei. Weiter geht’s!')}timer.remaining=timerSettings[timer.kind]*60;render()}},250)}
function action(el){const a=el.dataset.action,id=el.dataset.id,kind=el.dataset.kind;if(a==='more-toggle'){const menu=document.querySelector('#mobile-more'),open=menu.hasAttribute('hidden');menu.toggleAttribute('hidden',!open);el.setAttribute('aria-expanded',String(open));return}if(a==='new')return modal(kind);if(a==='course-open'){selectedCourse=id;page='course';return render()}if(a==='edit'){if(kind==='course')selectedCourse=id;return modal(kind,id)}if(a==='delete'){if(el.classList.contains('modal-delete'))document.querySelector('#dialog').close();return deleteItem(kind,id)}if(a==='toggle-task'){const t=db.tasks.find(t=>t.id===id);if(!t)return; t.done=!t.done;save();return render()}if(a==='note-delete')return deleteItem('note',id);if(a==='semester-save'){const s={...db.semester};document.querySelectorAll('[data-sem]').forEach(x=>s[x.dataset.sem]=x.type==='number'?Number(x.value):x.value);if(s.end<s.start)return toast('Semester end must be after the start date.');if(db.series.some(x=>x.from<s.start||x.to>s.end))return toast('Update the recurring class dates first.');db.semester=s;save();render();return toast('Semester saved')}if(a==='semester-view'){semesterView=el.dataset.value;return render()}if(a==='jump-week'){weekOffset=Number(el.dataset.offset);semesterView='week';return render()}if(a==='week-prev'){weekOffset--;return render()}if(a==='week-next'){weekOffset++;return render()}if(a==='week-now'){weekOffset=0;return render()}if(a==='calendar-mode'){calendarMode=el.dataset.value;return render()}if(a==='cal-prev'){calendarDate.setMonth(calendarDate.getMonth()-(calendarMode==='day'?0:calendarMode==='week'?0:1));if(calendarMode==='day')calendarDate.setDate(calendarDate.getDate()-1);if(calendarMode==='week')calendarDate.setDate(calendarDate.getDate()-7);return render()}if(a==='cal-next'){calendarDate.setMonth(calendarDate.getMonth()+(calendarMode==='day'?0:calendarMode==='week'?0:1));if(calendarMode==='day')calendarDate.setDate(calendarDate.getDate()+1);if(calendarMode==='week')calendarDate.setDate(calendarDate.getDate()+7);return render()}if(a==='cal-today'){calendarDate=new Date();return render()}if(a==='occurrence')return id.includes('@')?occurrenceAction(id,a):modal('event',id);if(a==='timer-start'){timerStart();return render()}if(a==='timer-pause'){timer.running=false;clearInterval(timer.interval);return render()}if(a==='timer-reset'){timer.running=false;clearInterval(timer.interval);timer.remaining=timerSettings[timer.kind]*60;return render()}if(a==='timer-settings'){timerSettings.study=Math.min(180,Math.max(1,Number(document.querySelector('#study-min').value)));timerSettings.break=Math.min(60,Math.max(1,Number(document.querySelector('#break-min').value)));timer.running=false;clearInterval(timer.interval);timer.kind='study';timer.remaining=timerSettings.study*60;return render()}if(a==='export')return exportBackup();if(a==='reset'){if(confirmEnglish('Alle Study Hub Daten auf diesem Gerät unwiderruflich löschen?')){localStorage.removeItem(KEY);db=starter();save();setPage('home');toast('Daten zurückgesetzt')}return}}
