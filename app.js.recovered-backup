if(kind==='series'){if(!d.title.trim())return toast('Enter a class title.');if(d.to<d.from||d.start>=d.end)return toast('Bitte prüfe Zeitraum und Uhrzeiten.');d.day=Number(d.day);if(d.from<db.semester.start||d.to>db.semester.end)return toast('Veranstaltungen müssen innerhalb des Semesters liegen.');put(db.series,{...item,...d,id:id||uuid()})}
if(kind==='block'){if(d.to<d.from)return toast('Das Enddatum muss nach dem Startdatum liegen.');db.blocks.push({...d,id:uuid()})}
